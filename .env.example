# List Beget accounts in one JSON line. Generate each token with: openssl rand -hex 32
BEGET_ACCOUNTS_JSON=[{"email":"first@example.com","password":"replace-me","token":"replace-with-unique-token-one-32chars"},{"email":"second@example.com","password":"replace-me","token":"replace-with-unique-token-two-32chars"}]

# Official Beget defaults. Override only if Beget support tells you to.
BEGET_IMAP_HOST=imap.beget.com
BEGET_IMAP_PORT=993
BEGET_SMTP_HOST=smtp.beget.com
BEGET_SMTP_PORT=465
BEGET_MAILBOX=INBOX

HOST=0.0.0.0
PORT=8000

