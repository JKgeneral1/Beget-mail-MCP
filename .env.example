# Beget mailbox. The username is normally the full email address.
BEGET_EMAIL=mailbox@example.com
BEGET_PASSWORD=replace-me

# Long random token used to protect the public MCP endpoint.
MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters

# Official Beget defaults. Override only if Beget support tells you to.
BEGET_IMAP_HOST=imap.beget.com
BEGET_IMAP_PORT=993
BEGET_SMTP_HOST=smtp.beget.com
BEGET_SMTP_PORT=465
BEGET_MAILBOX=INBOX

HOST=0.0.0.0
PORT=8000

